// SprayLab Direction's window and tray icon, in SprayLab's own look (src/range/ui/tokens.css and primitives.css): its
// colours, Rajdhani for display text and Barlow for the rest, sharp corners, panels with a header bar, square switches.
// Everything shown comes from `display`, which src/gui.rs fills from app::View; the controls report back through the
// callbacks. Wrapped text sits in components rather than directly in conditional layouts, where Slint measured it as one
// line and the card came out too short.

import { ScrollView } from "std-widgets.slint";
import "fonts/Barlow-Regular.ttf";
import "fonts/Barlow-Medium.ttf";
import "fonts/Barlow-SemiBold.ttf";
import "fonts/Barlow-Bold.ttf";
import "fonts/Rajdhani-SemiBold.ttf";
import "fonts/Rajdhani-Bold.ttf";

export struct ValueRow {
    name: string,
    yours: string,
    other: string,
    changed: bool,
}

export struct Display {
    // 0 set up, 1 off, 2 on, 3 changed outside, 4 switching (app::SETUP and the rest).
    phase: int,
    // 0 grey, 1 green, 2 amber, 3 red.
    tone: int,
    state: string,
    tag: string,
    // The tag's colour, as `tone`.
    tag-tone: int,
    action: string,
    action-enabled: bool,
    summary: string,
    hint: string,
    update: bool,
    can-locate: bool,
    has-profile: bool,
    profile-name: string,
    profile-detail: string,
    flicks: string,
    right: string,
    left: string,
    up: string,
    down: string,
    rotation: string,
    // 1 more sensitive, -1 less, 0 unchanged.
    right-sign: int,
    left-sign: int,
    up-sign: int,
    down-sign: int,
    rotation-sign: int,
    newer: string,
    raw-folder: string,
    raw-version: string,
    raw-rows: [ValueRow],
    raw-other: string,
    raw-profiles: [string],
    raw-profile-enabled: bool,
    hotkeys: [string],
    warning: string,
    message: string,
    error: bool,
}

// Primitive tokens: SprayLab's palette.
global SlColor {
    out property <color> bg: #07090c;
    out property <color> bg-top: #11161b;
    out property <color> panel: #0b0f13;
    out property <color> field: #1a2129;
    out property <color> text: #eef2f5;
    out property <color> text-body: #c3cbd2;
    out property <color> text-2: #aab4be;
    out property <color> text-3: #8b96a1;
    out property <color> go: #3c9a3e;
    out property <color> go-text: #6fcf73;
    out property <color> ct: #78a6dc;
    out property <color> t: #e2b35b;
    out property <color> danger: #e5534b;
    out property <color> hairline: #ffffff14;
    out property <color> hairline-strong: #ffffff24;
    out property <color> row-alt: #ffffff06;
    out property <color> row-hover: #ffffff0d;
}

// Semantic tokens: what each colour and font is for.
global Ui {
    out property <color> page: SlColor.bg;
    out property <color> surface: SlColor.panel;
    out property <color> field: SlColor.field;
    out property <color> line: SlColor.hairline;
    out property <color> line-strong: SlColor.hairline-strong;
    out property <color> row-alt: SlColor.row-alt;
    out property <color> row-hover: SlColor.row-hover;
    out property <color> text: SlColor.text;
    out property <color> text-body: SlColor.text-body;
    out property <color> text-muted: SlColor.text-2;
    out property <color> caption: SlColor.text-3;
    out property <color> action: SlColor.go;
    out property <color> on: SlColor.go-text;
    out property <color> attention: SlColor.t;
    out property <color> problem: SlColor.danger;
    out property <string> display-font: "Rajdhani";
    out property <length> radius: 2px;

    pure public function tone(tone: int) -> color {
        if tone == 1 {
            return SlColor.go-text;
        }
        if tone == 2 {
            return SlColor.t;
        }
        if tone == 3 {
            return SlColor.danger;
        }
        return SlColor.text-2;
    }

    // A direction that gets more sensitive is gold, less sensitive blue (CS2's T and CT colours).
    pure public function sign(sign: int) -> color {
        if sign > 0 {
            return SlColor.t;
        }
        if sign < 0 {
            return SlColor.ct;
        }
        return SlColor.text-2;
    }
}

// Small display-font label above or beside something, e.g. DIRECTION PROFILE.
component Kicker inherits Text {
    font-family: Ui.display-font;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1.8px;
    color: Ui.caption;
}

// A short coloured label such as 96 FLICKS (`.sl-tag`).
component Tag inherits Rectangle {
    in property <string> text;
    in property <color> ink: SlColor.ct;
    height: 20px;
    width: label.preferred-width + 12px;
    background: root.ink.with-alpha(0.12);
    border-radius: 1px;
    label := Text {
        text: root.text;
        font-family: Ui.display-font;
        font-weight: 700;
        font-size: 11px;
        letter-spacing: 1.3px;
        color: root.ink;
    }
}

// `.sl-button` and `.sl-button-primary`: SprayLab green with a display-font label for the main action, a hairline
// outline for the rest.
component SlButton {
    in property <string> text;
    in property <bool> primary;
    in property <bool> small;
    in property <bool> enabled: true;
    in property <length> wide: 0px;
    callback clicked;
    min-height: root.small ? 30px : 46px;
    min-width: max(root.wide, label.preferred-width + (root.small ? 26px : 44px));
    horizontal-stretch: 0;
    vertical-stretch: 0;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.clicked();
    }
    Rectangle {
        border-radius: Ui.radius;
        border-width: root.primary && root.enabled ? 0px : 1px;
        border-color: Ui.line-strong;
        background: !root.enabled ? #ffffff08 : root.primary
            ? (touch.pressed ? #337f35 : touch.has-hover ? #46ad48 : Ui.action)
            : (touch.pressed ? #ffffff1a : touch.has-hover ? Ui.row-hover : Ui.row-alt);
        // The primary button's inset highlight.
        if root.primary && root.enabled: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 1px;
            background: #ffffff47;
        }
    }
    label := Text {
        text: root.text;
        font-family: Ui.display-font;
        font-weight: 700;
        font-size: root.small ? 13px : 18px;
        letter-spacing: root.small ? 1.4px : 2.4px;
        color: root.enabled ? Ui.text : Ui.caption;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

// `.sl-switch`: a square 44 x 22 toggle, green when on.
component SlSwitch {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled(bool);
    width: 44px;
    height: 22px;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.flip();
    }
    function flip() {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }
    Rectangle {
        border-radius: 1px;
        background: !root.enabled ? #ffffff0d : root.checked ? Ui.action : #ffffff24;
    }
    Rectangle {
        x: root.checked ? 25px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 1px;
        background: !root.enabled ? Ui.caption : root.checked ? #ffffff : SlColor.text-2;
        animate x { duration: 110ms; easing: ease-out; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.flip();
        }
    }
}

component Chevron inherits Path {
    in property <bool> right;
    in property <color> ink: Ui.text-muted;
    width: 7px;
    height: 12px;
    viewbox-width: 7;
    viewbox-height: 12;
    commands: root.right ? "M 1 1 L 6 6 L 1 11" : "M 6 1 L 1 6 L 6 11";
    stroke: root.ink;
    stroke-width: 1.6px;
    fill: transparent;
}

// A ‹ value › picker for a few choices, like a game's settings menu.
component Stepper {
    in property <[string]> model;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    in property <string> label;
    callback selected(int);
    min-width: 150px;
    height: 30px;
    accessible-role: spinbox;
    accessible-label: root.label;
    accessible-value: root.model[root.current-index];
    accessible-action-increment => {
        root.step(1);
    }
    accessible-action-decrement => {
        root.step(-1);
    }
    function step(delta: int) {
        if !root.enabled || root.model.length == 0 {
            return;
        }
        root.current-index = Math.mod(root.current-index + delta + root.model.length, root.model.length);
        root.selected(root.current-index);
    }
    Rectangle {
        border-radius: Ui.radius;
        border-width: 1px;
        border-color: Ui.line-strong;
        background: Ui.field;
    }
    HorizontalLayout {
        back := TouchArea {
            width: 30px;
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => {
                root.step(-1);
            }
            Rectangle {
                background: back.has-hover ? Ui.row-hover : transparent;
                Chevron {
                    ink: root.enabled ? Ui.text : Ui.caption;
                }
            }
        }
        Text {
            text: root.model[root.current-index];
            horizontal-stretch: 1;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-weight: 600;
            color: root.enabled ? Ui.text : Ui.caption;
        }
        next := TouchArea {
            width: 30px;
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => {
                root.step(1);
            }
            Rectangle {
                background: next.has-hover ? Ui.row-hover : transparent;
                Chevron {
                    right: true;
                    ink: root.enabled ? Ui.text : Ui.caption;
                }
            }
        }
    }
}

// A 0 to 100 slider in steps, green up to the value, with a square thumb.
component Meter {
    in-out property <float> value;
    in property <float> step: 5;
    in property <bool> enabled: true;
    in property <string> label;
    callback changed(float);
    height: 28px;
    min-width: 80px;
    horizontal-stretch: 1;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: Math.round(root.value) + "%";
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-value-step: root.step;
    accessible-action-increment => {
        root.set(root.value + root.step);
    }
    accessible-action-decrement => {
        root.set(root.value - root.step);
    }
    property <length> inset: 7px;
    property <length> track: root.width - 2 * root.inset;
    function set(value: float) {
        let snapped = Math.clamp(Math.round(value / root.step) * root.step, 0, 100);
        if snapped != root.value {
            root.value = snapped;
            root.changed(snapped);
        }
    }
    Rectangle {
        x: root.inset;
        y: (root.height - self.height) / 2;
        width: root.track;
        height: 4px;
        background: #ffffff1f;
    }
    Rectangle {
        x: root.inset;
        y: (root.height - self.height) / 2;
        width: root.track * root.value / 100;
        height: 4px;
        background: root.enabled ? Ui.action : #ffffff2e;
    }
    Rectangle {
        x: root.inset + root.track * root.value / 100 - self.width / 2;
        y: (root.height - self.height) / 2;
        width: 12px;
        height: 18px;
        border-radius: 1px;
        background: !root.enabled ? Ui.caption : touch.pressed || touch.has-hover ? #ffffff : Ui.text;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.set((self.mouse-x - root.inset) / root.track * 100);
            }
        }
        moved => {
            if self.pressed {
                root.set((self.mouse-x - root.inset) / root.track * 100);
            }
        }
    }
}

// `.sl-panel`: a panel with a header bar, its title in the display font and an optional tag on the right.
component SlPanel inherits Rectangle {
    in property <string> title;
    in property <string> tag;
    in property <color> tag-ink: SlColor.ct;
    background: Ui.surface;
    border-width: 1px;
    border-color: Ui.line;
    border-radius: Ui.radius;
    VerticalLayout {
        alignment: start;
        Rectangle {
            height: 42px;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 12px;
                spacing: 8px;
                Text {
                    text: root.title;
                    font-family: Ui.display-font;
                    font-weight: 700;
                    font-size: 15px;
                    letter-spacing: 2.4px;
                    color: Ui.text;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                if root.tag != "": VerticalLayout {
                    alignment: center;
                    Tag {
                        text: root.tag;
                        ink: root.tag-ink;
                    }
                }
            }
            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Ui.line;
            }
        }
        @children
    }
}

// `.sl-setting-row`: a label (and a note under it) on the left, its control on the right; odd rows are shaded.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> note;
    in property <bool> shaded;
    min-height: root.note == "" ? 44px : 54px;
    background: root.shaded ? Ui.row-alt : transparent;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: Ui.text;
                font-size: 14px;
            }
            if root.note != "": Text {
                text: root.note;
                color: Ui.caption;
                font-size: 12px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

// One direction around the map: its name and how much more or less sensitive the profile makes it.
component GainLabel {
    in property <string> name;
    in property <string> value;
    in property <int> sign;
    in property <TextHorizontalAlignment> align: center;
    width: 86px;
    height: 40px;
    VerticalLayout {
        spacing: 0px;
        Text {
            text: root.name;
            font-family: Ui.display-font;
            font-weight: 700;
            font-size: 11px;
            letter-spacing: 1.6px;
            color: Ui.caption;
            horizontal-alignment: root.align;
        }
        Text {
            text: root.value;
            font-family: Ui.display-font;
            font-weight: 700;
            font-size: 23px;
            color: Ui.sign(root.sign);
            horizontal-alignment: root.align;
        }
    }
}

component Arrow inherits Path {
    in property <int> sign;
    // 0 up, 1 right, 2 down, 3 left.
    in property <int> towards;
    width: root.towards == 0 || root.towards == 2 ? 11px : 7px;
    height: root.towards == 0 || root.towards == 2 ? 7px : 11px;
    viewbox-width: root.towards == 0 || root.towards == 2 ? 11 : 7;
    viewbox-height: root.towards == 0 || root.towards == 2 ? 7 : 11;
    commands: root.towards == 0 ? "M 0 7 L 5.5 0 L 11 7 Z" : root.towards == 1 ? "M 0 0 L 7 5.5 L 0 11 Z" : root.towards == 2 ? "M 0 0 L 5.5 7 L 11 0 Z" : "M 7 0 L 0 5.5 L 7 11 Z";
    fill: Ui.sign(root.sign);
}

// The profile at a glance: the four directions around a dial with the rotation.
component DirectionMap {
    in property <Display> d;
    height: 180px;
    property <length> cx: root.width / 2;
    property <length> cy: root.height / 2;
    property <length> ring: 72px;
    // The axes, behind the dial.
    Rectangle {
        x: root.cx - 0.5px;
        y: 42px;
        width: 1px;
        height: root.height - 84px;
        background: Ui.line;
    }
    Rectangle {
        x: 88px;
        y: root.cy - 0.5px;
        width: root.width - 176px;
        height: 1px;
        background: Ui.line;
    }
    Rectangle {
        x: root.cx - root.ring / 2;
        y: root.cy - root.ring / 2;
        width: root.ring;
        height: root.ring;
        border-radius: root.ring / 2;
        border-width: 1px;
        border-color: Ui.line-strong;
        background: Ui.page;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.d.rotation;
                font-family: Ui.display-font;
                font-weight: 700;
                font-size: 20px;
                color: Ui.sign(root.d.rotation-sign);
                horizontal-alignment: center;
            }
            Text {
                text: "ROTATION";
                font-family: Ui.display-font;
                font-weight: 700;
                font-size: 9px;
                letter-spacing: 1.2px;
                color: Ui.caption;
                horizontal-alignment: center;
            }
        }
    }
    Arrow {
        towards: 0;
        sign: root.d.up-sign;
        x: root.cx - self.width / 2;
        y: root.cy - root.ring / 2 - 12px;
    }
    Arrow {
        towards: 2;
        sign: root.d.down-sign;
        x: root.cx - self.width / 2;
        y: root.cy + root.ring / 2 + 5px;
    }
    Arrow {
        towards: 3;
        sign: root.d.left-sign;
        x: root.cx - root.ring / 2 - 13px;
        y: root.cy - self.height / 2;
    }
    Arrow {
        towards: 1;
        sign: root.d.right-sign;
        x: root.cx + root.ring / 2 + 6px;
        y: root.cy - self.height / 2;
    }
    GainLabel {
        name: "UP";
        value: root.d.up;
        sign: root.d.up-sign;
        x: root.cx - self.width / 2;
        y: 0;
    }
    GainLabel {
        name: "DOWN";
        value: root.d.down;
        sign: root.d.down-sign;
        x: root.cx - self.width / 2;
        y: root.height - self.height;
    }
    GainLabel {
        name: "LEFT";
        value: root.d.left;
        sign: root.d.left-sign;
        align: left;
        x: 0;
        y: root.cy - self.height / 2;
    }
    GainLabel {
        name: "RIGHT";
        value: root.d.right;
        sign: root.d.right-sign;
        align: right;
        x: root.width - self.width;
        y: root.cy - self.height / 2;
    }
}

// The status card's text: what is on, and what it means.
component HeroText {
    in property <Display> d;
    horizontal-stretch: 1;
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        Kicker {
            text: "DIRECTION PROFILE";
        }
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: root.d.state;
                font-family: Ui.display-font;
                font-weight: 700;
                font-size: 34px;
                letter-spacing: 1.5px;
                color: Ui.tone(root.d.tone);
                vertical-alignment: center;
            }
            if root.d.tag != "": VerticalLayout {
                alignment: center;
                Tag {
                    text: root.d.tag;
                    ink: Ui.tone(root.d.tag-tone);
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        Text {
            text: root.d.summary;
            color: Ui.text-body;
            wrap: word-wrap;
        }
        Text {
            text: root.d.hint;
            color: Ui.caption;
            font-size: 13px;
            wrap: word-wrap;
        }
    }
}

// The status card's buttons, which change with the state.
component HeroActions {
    in property <Display> d;
    callback act();
    callback update-profile();
    callback locate();
    callback get-raw-accel();
    callback choose-profile();
    callback restore();
    callback keep();
    VerticalLayout {
        alignment: center;
        spacing: 8px;
        if root.d.phase == 1 || root.d.phase == 2 || root.d.phase == 4: SlButton {
            text: root.d.action;
            primary: root.d.phase == 1;
            enabled: root.d.action-enabled;
            wide: 210px;
            clicked => {
                root.act();
            }
        }
        if root.d.phase == 2 && root.d.update: SlButton {
            text: "APPLY CHANGES";
            small: true;
            wide: 210px;
            clicked => {
                root.update-profile();
            }
        }
        if root.d.phase == 0 && root.d.can-locate: SlButton {
            text: "LOCATE WRITER.EXE";
            primary: true;
            wide: 210px;
            clicked => {
                root.locate();
            }
        }
        if root.d.phase == 0 && root.d.can-locate: SlButton {
            text: "GET RAW ACCEL";
            small: true;
            wide: 210px;
            clicked => {
                root.get-raw-accel();
            }
        }
        if root.d.phase == 0 && !root.d.can-locate: SlButton {
            text: "CHOOSE PROFILE";
            primary: true;
            wide: 210px;
            clicked => {
                root.choose-profile();
            }
        }
        if root.d.phase == 3: SlButton {
            text: "RESTORE MY VALUES";
            primary: true;
            wide: 210px;
            clicked => {
                root.restore();
            }
        }
        if root.d.phase == 3: SlButton {
            text: "KEEP THESE VALUES";
            small: true;
            wide: 210px;
            clicked => {
                root.keep();
            }
        }
    }
}

// The status card across the top, with a stripe in the state's colour.
component Hero inherits Rectangle {
    in property <Display> d;
    callback act();
    callback update-profile();
    callback locate();
    callback get-raw-accel();
    callback choose-profile();
    callback restore();
    callback keep();
    background: Ui.surface;
    border-width: 1px;
    border-color: Ui.line;
    border-radius: Ui.radius;
    // A faint wash of the state's colour from the left, so the state reads at a glance.
    Rectangle {
        background: @linear-gradient(90deg, Ui.tone(root.d.tone).with-alpha(0.09) 0%, Ui.tone(root.d.tone).with-alpha(0) 60%);
    }
    Rectangle {
        x: 0;
        y: 0;
        width: 4px;
        height: parent.height;
        background: Ui.tone(root.d.tone);
    }
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 18px;
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 24px;
        HeroText {
            d: root.d;
        }
        HeroActions {
            d: root.d;
            act => {
                root.act();
            }
            update-profile => {
                root.update-profile();
            }
            locate => {
                root.locate();
            }
            get-raw-accel => {
                root.get-raw-accel();
            }
            choose-profile => {
                root.choose-profile();
            }
            restore => {
                root.restore();
            }
            keep => {
                root.keep();
            }
        }
    }
}

// Warnings, in amber, under the status card.
component Notice inherits Rectangle {
    in property <string> text;
    background: SlColor.t.with-alpha(0.07);
    border-width: 1px;
    border-color: SlColor.t.with-alpha(0.3);
    border-radius: Ui.radius;
    Rectangle {
        x: 0;
        y: 0;
        width: 3px;
        height: parent.height;
        background: Ui.attention;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        Text {
            text: root.text;
            color: Ui.attention;
            wrap: word-wrap;
        }
    }
}

component NewerDownload inherits Rectangle {
    in property <string> text;
    callback use-it();
    background: SlColor.t.with-alpha(0.07);
    border-radius: Ui.radius;
    HorizontalLayout {
        padding: 8px;
        padding-left: 10px;
        spacing: 10px;
        Text {
            text: root.text;
            color: Ui.attention;
            font-size: 13px;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            SlButton {
                text: "USE IT";
                small: true;
                clicked => {
                    root.use-it();
                }
            }
        }
    }
}

component ProfileFile {
    in property <Display> d;
    callback choose-profile();
    callback use-newer();
    VerticalLayout {
        padding-left: 14px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 10px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                horizontal-stretch: 1;
                Text {
                    text: root.d.profile-name;
                    color: Ui.text;
                    font-size: 13px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.d.profile-detail;
                    color: Ui.caption;
                    font-size: 12px;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                SlButton {
                    text: "CHOOSE";
                    small: true;
                    clicked => {
                        root.choose-profile();
                    }
                }
            }
        }
        if root.d.newer != "": NewerDownload {
            text: root.d.newer;
            use-it => {
                root.use-newer();
            }
        }
    }
}

component ProfilePanel inherits SlPanel {
    in property <Display> d;
    in-out property <float> strength;
    callback strength-chosen(float);
    callback choose-profile();
    callback use-newer();
    title: "PROFILE";
    tag: root.d.flicks;
    tag-ink: SlColor.ct;
    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 8px;
        spacing: 4px;
        DirectionMap {
            d: root.d;
        }
        Text {
            text: "Gold: more sensitive that way. Blue: less.";
            color: Ui.caption;
            font-size: 12px;
            horizontal-alignment: center;
        }
    }
    SettingRow {
        label: "Strength";
        shaded: true;
        HorizontalLayout {
            spacing: 8px;
            width: 170px;
            Meter {
                label: "Strength";
                value <=> root.strength;
                enabled: root.d.has-profile;
                changed(value) => {
                    root.strength-chosen(value);
                }
            }
            Text {
                text: Math.round(root.strength) + "%";
                font-family: Ui.display-font;
                font-weight: 700;
                font-size: 16px;
                color: Ui.text;
                width: 42px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
    ProfileFile {
        d: root.d;
        choose-profile => {
            root.choose-profile();
        }
        use-newer => {
            root.use-newer();
        }
    }
}

component ValueHeader inherits Rectangle {
    in property <string> other;
    height: 28px;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        Rectangle {
            width: 82px;
        }
        Kicker {
            text: "YOURS";
            horizontal-stretch: 1;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-size: 11px;
        }
        Kicker {
            text: root.other;
            horizontal-stretch: 1;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-size: 11px;
        }
    }
}

component ValueLine inherits Rectangle {
    in property <ValueRow> value;
    in property <bool> shaded;
    height: 30px;
    background: root.shaded ? Ui.row-alt : transparent;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        Text {
            text: root.value.name;
            width: 82px;
            color: Ui.text-muted;
            font-size: 13px;
            vertical-alignment: center;
        }
        Text {
            text: root.value.yours;
            horizontal-stretch: 1;
            color: Ui.text-body;
            font-size: 14px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            text: root.value.other;
            horizontal-stretch: 1;
            color: root.value.changed ? Ui.text : Ui.caption;
            font-size: 14px;
            font-weight: root.value.changed ? 600 : 400;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

component RawMissing {
    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-bottom: 12px;
        Text {
            text: "SprayLab Direction finds Raw Accel when it sits next to writer.exe in Raw Accel's folder. Elsewhere, locate writer.exe.";
            color: Ui.caption;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

component RawPanel inherits SlPanel {
    in property <Display> d;
    in-out property <int> raw-profile-index;
    callback raw-profile-chosen(int);
    callback locate();
    title: "RAW ACCEL";
    tag: root.d.raw-version;
    tag-ink: SlColor.ct;
    // Its folder on a line of its own, wrapping anywhere: a path has no spaces to wrap at.
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        Text {
            text: root.d.raw-folder;
            color: Ui.text-muted;
            font-size: 12px;
            wrap: char-wrap;
        }
    }
    if root.d.raw-rows.length == 0: RawMissing { }
    if root.d.raw-profiles.length > 1: SettingRow {
        label: "Profile";
        shaded: true;
        Stepper {
            label: "Raw Accel profile";
            model: root.d.raw-profiles;
            current-index <=> root.raw-profile-index;
            enabled: root.d.raw-profile-enabled;
            selected(index) => {
                root.raw-profile-chosen(index);
            }
        }
    }
    if root.d.raw-rows.length > 0: ValueHeader {
        other: root.d.raw-other;
    }
    for entry[index] in root.d.raw-rows: ValueLine {
        value: entry;
        shaded: Math.mod(index, 2) == 0;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        alignment: start;
        SlButton {
            text: "LOCATE RAW ACCEL";
            small: true;
            clicked => {
                root.locate();
            }
        }
    }
}

component SwitchingPanel inherits SlPanel {
    in property <Display> d;
    in-out property <int> hotkey-index;
    in-out property <bool> cs2-only;
    in-out property <bool> beep;
    in-out property <bool> startup;
    in property <bool> startup-available;
    callback hotkey-chosen(int);
    callback cs2-only-toggled(bool);
    callback beep-toggled(bool);
    callback startup-toggled(bool);
    title: "SWITCHING";
    SettingRow {
        label: "Hotkey";
        note: "Also in game";
        shaded: true;
        Stepper {
            label: "Hotkey";
            model: root.d.hotkeys;
            current-index <=> root.hotkey-index;
            selected(index) => {
                root.hotkey-chosen(index);
            }
        }
    }
    SettingRow {
        label: "Only while CS2 runs";
        note: "On when it starts, off when it closes";
        SlSwitch {
            label: "Only while CS2 runs";
            checked <=> root.cs2-only;
            toggled(on) => {
                root.cs2-only-toggled(on);
            }
        }
    }
    SettingRow {
        label: "Beep on hotkey";
        note: "High for on, low for off";
        shaded: true;
        SlSwitch {
            label: "Beep on hotkey";
            checked <=> root.beep;
            toggled(on) => {
                root.beep-toggled(on);
            }
        }
    }
    SettingRow {
        label: "Start with Windows";
        note: "In the tray, next to the clock";
        SlSwitch {
            label: "Start with Windows";
            checked <=> root.startup;
            enabled: root.startup-available;
            toggled(on) => {
                root.startup-toggled(on);
            }
        }
    }
}

// The last result, or what closing the window does.
component Footer {
    in property <Display> d;
    callback quit();
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 10px;
        padding-bottom: 14px;
        spacing: 16px;
        Text {
            text: root.d.message != "" ? root.d.message : "Closing this window keeps SprayLab Direction running in the tray, next to the clock.";
            color: root.d.message == "" ? Ui.caption : root.d.error ? Ui.problem : Ui.text-muted;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            SlButton {
                text: "QUIT";
                small: true;
                clicked => {
                    root.quit();
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "SprayLab Direction";
    icon: root.window-icon;
    preferred-width: 960px;
    preferred-height: 700px;
    min-width: 900px;
    min-height: 480px;
    background: @linear-gradient(180deg, SlColor.bg-top 0%, SlColor.bg 60%);
    default-font-family: "Barlow";
    default-font-size: 14px;

    in property <image> window-icon;
    in property <image> logo;
    in property <Display> display;
    in-out property <float> strength: 100;
    in-out property <int> hotkey-index;
    in-out property <int> raw-profile-index;
    in-out property <bool> cs2-only;
    in-out property <bool> beep: true;
    in-out property <bool> startup;
    in property <bool> startup-available: true;

    // The status card's main button: switch on or off.
    callback act();
    callback update-profile();
    // Raw Accel changed outside: put back your own values, or keep the current ones as your own.
    callback restore();
    callback keep();
    callback locate();
    callback get-raw-accel();
    callback choose-profile();
    callback use-newer();
    callback strength-chosen(float);
    callback hotkey-chosen(int);
    callback raw-profile-chosen(int);
    callback cs2-only-toggled(bool);
    callback beep-toggled(bool);
    callback startup-toggled(bool);
    callback quit();

    VerticalLayout {
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            padding-bottom: 12px;
            spacing: 12px;
            Image {
                source: root.logo;
                width: 36px;
                height: 36px;
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: "SPRAYLAB DIRECTION";
                    font-family: Ui.display-font;
                    font-weight: 700;
                    font-size: 22px;
                    letter-spacing: 2.6px;
                    color: Ui.text;
                }
                Text {
                    text: "Your Direction Calibration in CS2 and every other game, through Raw Accel";
                    font-size: 12px;
                    color: Ui.caption;
                }
            }
        }

        // Scrolls when the window is smaller than its content, so nothing is ever cut off.
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-bottom: 4px;
                spacing: 14px;
                Hero {
                    d: root.display;
                    act => {
                        root.act();
                    }
                    update-profile => {
                        root.update-profile();
                    }
                    locate => {
                        root.locate();
                    }
                    get-raw-accel => {
                        root.get-raw-accel();
                    }
                    choose-profile => {
                        root.choose-profile();
                    }
                    restore => {
                        root.restore();
                    }
                    keep => {
                        root.keep();
                    }
                }
                if root.display.warning != "": Notice {
                    text: root.display.warning;
                }
                // Three columns that set their own preferred widths, so none takes more because of its text.
                HorizontalLayout {
                    spacing: 14px;
                    ProfilePanel {
                        preferred-width: 340px;
                        horizontal-stretch: 4;
                        d: root.display;
                        strength <=> root.strength;
                        strength-chosen(value) => {
                            root.strength-chosen(value);
                        }
                        choose-profile => {
                            root.choose-profile();
                        }
                        use-newer => {
                            root.use-newer();
                        }
                    }
                    RawPanel {
                        preferred-width: 276px;
                        horizontal-stretch: 3;
                        d: root.display;
                        raw-profile-index <=> root.raw-profile-index;
                        raw-profile-chosen(index) => {
                            root.raw-profile-chosen(index);
                        }
                        locate => {
                            root.locate();
                        }
                    }
                    SwitchingPanel {
                        preferred-width: 276px;
                        horizontal-stretch: 3;
                        d: root.display;
                        hotkey-index <=> root.hotkey-index;
                        cs2-only <=> root.cs2-only;
                        beep <=> root.beep;
                        startup <=> root.startup;
                        startup-available: root.startup-available;
                        hotkey-chosen(index) => {
                            root.hotkey-chosen(index);
                        }
                        cs2-only-toggled(on) => {
                            root.cs2-only-toggled(on);
                        }
                        beep-toggled(on) => {
                            root.beep-toggled(on);
                        }
                        startup-toggled(on) => {
                            root.startup-toggled(on);
                        }
                    }
                }
            }
        }

        Footer {
            d: root.display;
            quit => {
                root.quit();
            }
        }
    }
}

// The tray icon: left click opens the window, right click shows this menu.
export component Tray inherits SystemTrayIcon {
    in property <image> picture;
    in property <string> tip;
    in property <bool> on;
    in property <bool> working;
    in property <string> hotkey-text;
    callback toggle();
    callback open();
    callback quit();
    icon: root.picture;
    tooltip: root.tip;
    clicked => {
        root.open();
    }
    Menu {
        MenuItem {
            // A tab right-aligns the hotkey, as Windows menus show shortcuts.
            title: (root.working ? "Switching…" : root.on ? "Turn off" : "Turn on") + (root.hotkey-text == "" ? "" : "\u{9}" + root.hotkey-text);
            enabled: !root.working;
            activated => {
                root.toggle();
            }
        }
        MenuItem {
            title: "Open SprayLab Direction";
            activated => {
                root.open();
            }
        }
        MenuSeparator { }
        MenuItem {
            title: "Quit";
            activated => {
                root.quit();
            }
        }
    }
}
